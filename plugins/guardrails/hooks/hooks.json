{
  "description": "Block force pushes, commits to the default branch, and edits to .env files.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs"],
            "timeout": 15,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
